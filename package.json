{
  "name": "azeel-node-api",
  "version": "0.1.0",
  "description": "Node.js client for the Azeel.net remote HTTP API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
